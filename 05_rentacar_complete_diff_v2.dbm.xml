<view name="vw_desempenho_modelos" layers="0" collapse-mode="0" faded-out="true" max-obj-count="18" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="80" y="380"/>
	<reference object="public.montadora" type="table" ref-name="tb_mon" ref-alias="mon" use-signature="true" format-name="true"/>
	<reference object="public.modelo" type="table" ref-name="tb_mod" ref-alias="m" use-signature="true" format-name="true"/>
	<reference object="public.aluguel" type="table" ref-name="tb_al" ref-alias="a" use-signature="true" format-name="true"/>
	<reference object="public.aluguel.id" type="column" ref-name="al_id" format-name="true"/>
	<reference object="public.aluguel.data_inicio" type="column" ref-name="al_dt_inicio"/>
	<reference object="public.aluguel.data_fim" type="column" ref-name="al_dt_fim"/>
	<reference object="public.aluguel.status" type="column" ref-name="al_status"/>
	<reference object="public.aluguel.valor_diaria" type="column" ref-name="al_val_diaria"/>
	<reference object="public.aluguel.modelo_id" type="column" ref-name="al_mod_id"/>
	<reference object="public.modelo.id" type="column" ref-name="m_id" ref-alias="modelo_id" use-columns="true"/>
	<reference object="public.modelo.montadora_id" type="column" ref-name="m_mon_id"/>
	<reference object="public.montadora.nome" type="column" ref-name="mon_nome" ref-alias="montadora" use-columns="true"/>
	<reference object="public.modelo.nome" type="column" ref-name="m_nome" ref-alias="modelo" use-columns="true"/>
	<reference object="public.modelo.categoria" type="column" ref-name="m_categoria" use-columns="true"/>
	<reference object="public.montadora.id" type="column" ref-name="mon_id"/>
	<simplecol name="total_alugueis" type="integer"/>
	<simplecol name="receita_total" type="numeric(12,2)"/>
	<definition> <![CDATA[SELECT 
  @{tb_mod}.{m_id} AS @{m_id},
  @{tb_mon}.{mon_nome} AS @{mon_nome},
  @{tb_mod}.{m_nome} AS @{m_nome},
  @{tb_mod}.{m_categoria},
  COUNT(@{tb_al}.{al_id}) AS total_alugueis,
  COALESCE(
      SUM(
          CASE 
              WHEN @{tb_al}.{al_status} IN ('concluido', 'em_andamento') 
              THEN ((@{tb_al}.{al_dt_fim} - 
                     @{tb_al}.{al_dt_inicio} + 1) * 
                     @{tb_al}.{al_val_diaria})
              ELSE 0 
          END
      ), 0.00
  )::numeric(12,2) AS receita_total
FROM {tb_mod} AS @{tb_mod}
JOIN {tb_mon} AS @{tb_mon} 
  ON @{tb_mod}.{m_mon_id} = @{tb_mon}.{mon_id}
LEFT JOIN {tb_al} AS @{tb_al} 
  ON @{tb_al}.{al_mod_id} = @{tb_mod}.{m_id}
GROUP BY @{tb_mod}.{m_id}, @{tb_mon}.{mon_nome}, 
         @{tb_mod}.{m_nome},  @{tb_mod}.{m_categoria}
ORDER BY total_alugueis DESC, receita_total DESC
]]> </definition>
</view>

